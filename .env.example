# Copy this file to .env (or set these as environment variables in Coolify)
# before building/running docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=kitchen_manager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kitchen_manager

# --- Backend (kitchen-manager-backend) ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=km.sid
# Comma-separated exact origins allowed to call the API, e.g.:
# CORS_ORIGINS=https://kitchen.example.com
CORS_ORIGINS=
# Optional comma-separated regex patterns for allowed origins, e.g.:
# CORS_ORIGIN_PATTERNS=^https:\/\/.+\.example\.com$
CORS_ORIGIN_PATTERNS=

# --- Frontend (kitchen-manager-frontend) ---
# Public URL the browser should use to reach the backend, e.g. https://api.example.com
VITE_API_BASE_URL=https://api.example.com
